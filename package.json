{
  "name": "discrepances",
  "description": "show discrepances in several flavors",
  "version": "0.3.1",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenautas/discrepances.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    },
    {
      "name": "Diego Florio",
      "email": "diegoefe@gmail.com"
    }
  ],
  "main": "lib/discrepances.js",
  "types": "lib/discrepances.d.ts",
  "files": [
    "lib"
  ],
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.0",
    "uuid": "^14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "dependencies": {
    "best-globals": "^2.2.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "expect.js": "^0.3.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "typescript": "^5.9.3",
    "audit-copy": "^0.2.1",
    "json4all": "^1.4.5",
    "qa-control": "^0.12.2",
    "require-bro": "^0.4.1",
    "server4test": "^2.0.0-rc.2"
  },
  "engines": {
    "node": ">= 14.x"
  },
  "scripts": {
    "test": "mocha --reporter spec --bail --check-leaks test/",
    "test-ci": "nyc --silent mocha --reporter spec --check-leaks test/ && npm run test-navigator && nyc report",
    "test-cov": "nyc mocha test/",
    "test-cov3": "nyc mocha --reporter dot --check-leaks test/",
    "test-cov2": "nyc mocha --exit --check-leaks test/",
    "start": "node example/server.js",
    "build-test": "nyc instrument --delete lib local-instrumented/lib",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test",
    "report": "nyc report",
    "all": "npm test && npm run test-cov && npm run report && qa-control . -v"
  },
  "nyc": {
    "exclude": [
      "test"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "extension": [
      ".js",
      ".ts"
    ],
    "sourceMap": true,
    "instrument": true,
    "check-coverage": true
  },
  "qa-control": {
    "gha": "all",
    "coverage": 95,
    "run-in": "both",
    "type": "lib",
    "silenced": [
      "eslint_warnings_in_file_1"
    ]
  }
}
